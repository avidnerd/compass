# --- Required server-only secrets ---
OPENROUTER_API_KEY=""
# Any long random string (e.g. `openssl rand -hex 32`). Derives the key that
# encrypts your bridge/GitHub tokens at rest. Change it and you will have to
# re-enter those tokens in Settings -> Connections.
COMPASS_APP_SECRET=""

# --- How Compass reads your connected accounts ---
#
# The Apps Script bridge you deploy in your own Google account. See
# college-os/bridge/README.md. Covers Drive, Docs, Sheets, Slides, Calendar,
# and Gmail. You can also set these per profile in the app under
# Settings -> Connections instead of here.
#COMPASS_BRIDGE_URL="https://script.google.com/macros/s/…/exec"
#COMPASS_BRIDGE_TOKEN=""
#
# GitHub: a fine-grained PAT with read-only repo access.
#COMPASS_GITHUB_TOKEN=""

# --- Optional ---
# Preferred model for the interest scan (re-verified as free at runtime;
# falls back to the default chain if it doesn't qualify).
#OPENROUTER_SCAN_MODEL="nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free"

# Preferred model for evidence verification (same rules as above).
#OPENROUTER_VERIFY_MODEL="nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free"

# Preferred free, image-capable model for sampled focus screenshots. Frames
# are removed after analysis unless the local-only debug flag below is true.
#OPENROUTER_FOCUS_MODEL="nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free"
#COMPASS_FOCUS_FRAME_INTERVAL_SECONDS="20"
#COMPASS_RETAIN_FOCUS_FRAMES="false"

# Show the exact content excerpt verification read on the evidence card.
# OFF by default: turning it on writes file excerpts into your local DB.
#COMPASS_DEBUG_EVIDENCE="false"

# Per-file character cap on content read for verification (up to 3 files).
#COMPASS_VERIFY_EXCERPT_CHARS="24000"

# Free-model preference order (each is re-verified as free at runtime).
#OPENROUTER_MODEL="google/gemma-4-26b-a4b-it:free"
#OPENROUTER_FALLBACK_MODELS="openai/gpt-oss-20b:free,nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-nano-9b-v2:free"

#COMPASS_FRONTEND_ORIGIN="http://localhost:5173"
#COMPASS_TIMEZONE="UTC"
#COMPASS_BIND_HOST="127.0.0.1"
#COMPASS_PUBLIC_MODE="false"
#COMPASS_DEMO_MODE="false"
#COMPASS_WORK_HOURS_START="9"
#COMPASS_WORK_HOURS_END="18"

# --- College OS (college-os/) -------------------------------------------
# Names the Apps Script provisioner created in your Google account. Override
# only if you renamed the Drive folder or the dashboard spreadsheet.
#COMPASS_COLLEGE_ROOT_FOLDER="COLLEGE"
#COMPASS_COLLEGE_DASHBOARD_NAME="COLLEGE DASHBOARD"
# Dashboard cell content is never written to disk. This is how long one read
# is kept in process memory before the College page re-reads the sheet.
#COMPASS_COLLEGE_DASHBOARD_MEMO_SECONDS="300"
